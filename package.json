{
  "name": "cryptoshield",
  "version": "0.1.0",
  "private": true,
  "description": "CryptoShield — interactive lab demonstrating email transport vulnerabilities vs. end-to-end cryptographic protection (Phase 1)",
  "scripts": {
    "dev": "node scripts/clean-next.mjs && next dev",
    "dev:keep": "next dev",
    "build": "node scripts/clean-next.mjs && next build",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dompurify": "^3.1.7",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
