# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (runtime + migrations).
# Managed Postgres examples:
#   postgresql://USER:PASSWORD@HOST:5432/freeshield?schema=public&sslmode=require
# Local option without Docker: `npx prisma dev` prints a ready-to-use URL.
# Append `pgbouncer=true` for a PgBouncer pooler or the local Prisma proxy
# (it disables Prisma's prepared-statement cache).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freeshield?schema=public"

# ── Origin ──────────────────────────────────────────────────────────────────
# Canonical origin used by the same-origin guard on mutating API routes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
